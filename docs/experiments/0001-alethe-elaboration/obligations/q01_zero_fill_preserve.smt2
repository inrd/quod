(set-logic ALL)
(declare-const a (Seq Int))(declare-const i Int)
(assert (and (<= 0 i) (< i (seq.len a))))
(assert (forall ((k Int)) (=> (and (<= 0 k) (< k i)) (= (seq.nth a k) 0))))
(assert (not (forall ((k Int)) (=> (and (<= 0 k) (< k (+ i 1))) (= (seq.nth (seq.update a i (seq.unit 0)) k) 0)))))
(check-sat)
