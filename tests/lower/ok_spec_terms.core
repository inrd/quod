(quod-core 0)

(fn bits
  (params (x u32) (dst (mut (slice u32))))
  (ret u32)
  (requires
    (and (> (int (len dst)) 0) (= (int (band.u32 x 1u32)) 0)))
  (ensures
    (<= (int (shr.u32 result 1u32)) (int result))
    (exists k -1 (int (len dst)) (or (= k -1) (= (int (sel dst k)) (+ (int (old (sel dst k))) 0))))
    (=> (not (= (int result) (int x))) (< (- 0 (+ (int x) 1)) 0)))
  (body
    (let $0 u32 (not.u32 x))
    (store dst 0usize $0)
    (store dst 0usize x)
    (let $1 u32 (bor.u32 x 2u32))
    (return $1)))

(fn noop
  (params (flag bool))
  (ret unit)
  (requires)
  (ensures
    (= flag flag))
  (body
    (let $0 bool (not.bool flag))
    (if $0
      (then
        (return))
      (else))
    (call noop2)
    (return)))

(fn noop2
  (params)
  (ret unit)
  (requires)
  (ensures)
  (body
    (return)))
